
<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="usecase" name="Use Case Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10"
      page="1" pageWidth="1100" pageHeight="750">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="E-Commerce Marketplace - Use Case Diagram"
          style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="600" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="system" value="E-Commerce Marketplace"
          style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeColor=#64748b;verticalAlign=top;fontStyle=1;spacingTop=12;"
          vertex="1" parent="1">
          <mxGeometry x="250" y="100" width="720" height="560" as="geometry"/>
        </mxCell>

        <mxCell id="buyer" value="Buyer"
          style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;"
          vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="60" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="login" value="Register / Log In"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="200" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="browse" value="Browse Products"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="680" y="150" width="200" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="cart" value="Manage Shopping Cart"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="300" y="260" width="200" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="review" value="Review Cart and Total"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="680" y="260" width="200" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="delivery" value="Enter Delivery Details"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="300" y="370" width="200" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="stock" value="Validate Product Stock"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
          vertex="1" parent="1">
          <mxGeometry x="680" y="370" width="200" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="place" value="Place Order"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="300" y="480" width="200" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="confirm" value="View Order Confirmation"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
          vertex="1" parent="1">
          <mxGeometry x="680" y="480" width="200" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="buyer" target="login"
          style="endArrow=none;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="buyer" target="browse"
          style="endArrow=none;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="buyer" target="cart"
          style="endArrow=none;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="buyer" target="delivery"
          style="endArrow=none;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="buyer" target="place"
          style="endArrow=none;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="includes" edge="1" parent="1" source="cart" target="review"
          style="dashed=1;endArrow=open;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="checks" edge="1" parent="1" source="delivery" target="stock"
          style="dashed=1;endArrow=open;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="successful checkout" edge="1" parent="1" source="place" target="confirm"
          style="endArrow=block;html=1;rounded=0;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
